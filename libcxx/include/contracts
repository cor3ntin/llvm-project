#ifndef _LIBCPP_CONTRACTS
#define _LIBCPP_CONTRACTS

#include <__config>
#include <source_location>
#include <version>
#include <__new/nothrow_t.h>
#include <__utility/unreachable.h>


#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#pragma GCC system_header
#endif

namespace std::contracts {

enum class assertion_kind : unsigned char { __unknown = 0, pre = 1, post = 2, assert = 3, manual = 4, cassert = 5 };
using _AssertKind = assertion_kind;
// P2900R14's numbering, which is what the reference implementation uses. It is
// deliberately not clang's ContractEvaluationSemantic ordering, so the compiler
// translates rather than casts - see mapSemanticToLibraryValue.
enum class evaluation_semantic : unsigned char {
  __unknown     = 0,
  ignore        = 1,
  observe       = 2,
  enforce       = 3,
  quick_enforce = 4
};
using _EvaluationSemantic = evaluation_semantic;

// D4324: which side of a call a contract's check happens on. A contract_assert
// is a statement inside a function body rather than something on a boundary a
// caller can see, so it has no side.
enum class assertion_check_side : unsigned char { not_applicable = 0, definition = 1, client = 2 };

class assertion_static_info;
enum class detection_mode : unsigned char { unspecified = 0, predicate_false = 1, evaluation_exception = 2, };
using _DetectionMode = detection_mode;

} // namespace std::contracts

namespace std {

// D4324: the compiler synthesizes a call to this when it needs to hand a
// contract's static properties to a contract control object's is_ignored() or
// constify(). It is reserved for that purpose and is not meant to be called
// directly; naming it here is what lets assertion_static_info keep its members
// private. If a translation unit names a control object without including
// <contracts>, the lookup fails and the compiler says so.
consteval contracts::assertion_static_info
__create_assertion_static_info(contracts::evaluation_semantic __semantic,
                               contracts::assertion_check_side __side,
                               bool __is_virtual,
                               bool __overrides_virtual) noexcept;

} // namespace std

namespace std::contracts {

// D4324: the compile-time-known properties of where a contract occurs,
// independent of any one runtime evaluation of it. is_virtual() and
// overrides_virtual() are groundwork for virtual-function semantics; the
// compiler fills both with false for now whatever the enclosing function is.
class assertion_static_info {
  evaluation_semantic __semantic_    = evaluation_semantic::__unknown;
  assertion_check_side __side_       = assertion_check_side::not_applicable;
  bool __is_virtual_                 = false;
  bool __overrides_virtual_          = false;

  friend consteval assertion_static_info std::__create_assertion_static_info(
      evaluation_semantic, assertion_check_side, bool, bool) noexcept;

public:
  constexpr assertion_static_info() noexcept = default;

  constexpr evaluation_semantic semantic() const noexcept { return __semantic_; }
  constexpr assertion_check_side side() const noexcept { return __side_; }
  constexpr bool is_virtual() const noexcept { return __is_virtual_; }
  constexpr bool overrides_virtual() const noexcept { return __overrides_virtual_; }
};

} // namespace std::contracts

namespace std {

consteval contracts::assertion_static_info
__create_assertion_static_info(contracts::evaluation_semantic __semantic,
                               contracts::assertion_check_side __side,
                               bool __is_virtual,
                               bool __overrides_virtual) noexcept {
  contracts::assertion_static_info __info;
  __info.__semantic_          = __semantic;
  __info.__side_              = __side;
  __info.__is_virtual_        = __is_virtual;
  __info.__overrides_virtual_ = __overrides_virtual;
  return __info;
}

} // namespace std

namespace std::contracts {
class assertion_context;
} // namespace std::contracts

namespace std {

// D4324: the compiler synthesizes a call to this at each contract that names a
// control object, to describe one evaluation of it. Reserved for that purpose.
// __check evaluates the predicate; __args carries the addresses of everything
// that predicate reads out of the function the contract is attached to, which is
// what lets the predicate be evaluated from outside that function.
constexpr contracts::assertion_context
__create_assertion_context(const char* __comment,
                           source_location __loc,
                           contracts::assertion_static_info __info,
                           contracts::assertion_kind __kind,
                           bool (*__check)(void**),
                           void** __args) noexcept;

} // namespace std

namespace std::contracts {

// D4324: one evaluation of one contract assertion.
//
// check() is the point of the design. The compiler no longer evaluates the
// predicate and then reports a failure; it hands the control object this and
// lets the object decide whether to evaluate the predicate at all, how many
// times, and what a false answer means. That is what makes it possible for an
// object to ignore an assertion at run time, to evaluate it twice, or to wrap
// the evaluation in a try block and treat a thrown exception as a violation.
class assertion_context {
  const char* __comment_        = nullptr;
  source_location __loc_        = {};
  assertion_static_info __info_ = {};
  assertion_kind __kind_        = assertion_kind::__unknown;
  bool (*__check_)(void**)      = nullptr;
  void** __args_                = nullptr;

  friend constexpr assertion_context std::__create_assertion_context(
      const char*, source_location, assertion_static_info, assertion_kind, bool (*)(void**), void**) noexcept;

public:
  constexpr const char* comment() const noexcept { return __comment_; }
  constexpr source_location location() const noexcept { return __loc_; }
  constexpr assertion_kind kind() const noexcept { return __kind_; }
  constexpr const assertion_static_info& static_info() const noexcept { return __info_; }
  constexpr evaluation_semantic semantic() const noexcept { return __info_.semantic(); }

  /// Evaluate the predicate. May be called any number of times, including none.
  ///
  /// During constant evaluation there is no type-erased function to call - the
  /// checker's body is generated by the code generator - so the compiler
  /// evaluates the predicate directly instead.
  constexpr bool check() const {
    if consteval {
      return __builtin_contract_check();
    } else {
      return __check_(__args_);
    }
  }
};

} // namespace std::contracts

namespace std {

constexpr contracts::assertion_context
__create_assertion_context(const char* __comment,
                           source_location __loc,
                           contracts::assertion_static_info __info,
                           contracts::assertion_kind __kind,
                           bool (*__check)(void**),
                           void** __args) noexcept {
  contracts::assertion_context __ctx;
  __ctx.__comment_ = __comment;
  __ctx.__loc_     = __loc;
  __ctx.__info_    = __info;
  __ctx.__kind_    = __kind;
  __ctx.__check_   = __check;
  __ctx.__args_    = __args;
  return __ctx;
}

} // namespace std

namespace std::contracts {

struct _ContractViolationImpl;

class contract_violation {
  // no user−accessible constructor
  friend struct _ContractViolationImpl;

public:
  ~contract_violation()                                    = default;
  contract_violation(const contract_violation&)            = delete;
  contract_violation& operator=(const contract_violation&) = delete;

  _LIBCPP_EXPORTED_FROM_ABI std::source_location location() const noexcept;
  _LIBCPP_EXPORTED_FROM_ABI const char* comment() const noexcept;
  _LIBCPP_EXPORTED_FROM_ABI _DetectionMode detection_mode() const noexcept;
  _LIBCPP_EXPORTED_FROM_ABI assertion_kind kind() const noexcept;
  _LIBCPP_EXPORTED_FROM_ABI evaluation_semantic semantic() const noexcept;

private:
  explicit contract_violation(const _ContractViolationImpl* impl) noexcept : __pimpl_(impl) {}

  const _ContractViolationImpl* __pimpl_;
};

_LIBCPP_EXPORTED_FROM_ABI void invoke_default_contract_violation_handler(const contract_violation&) noexcept;

_LIBCPP_EXPORTED_FROM_ABI void __handle_manual_contract_violation(
  assertion_kind __kind,
  evaluation_semantic __semantic,
  detection_mode __mode,
  const char* __comment,
  std::source_location __loc,
  bool __can_throw
);


inline void handle_observed_contract_violation(
    const char* __comment,
    const std::source_location &__loc = std::source_location::current()) {
  __handle_manual_contract_violation(assertion_kind::manual,
                                     evaluation_semantic::observe, detection_mode::unspecified,
                                     __comment, __loc,
                                     /*__can_throw=*/true);
}

inline void handle_observed_contract_violation(
    nothrow_t,
    const char* __comment,
    const std::source_location& __loc = std::source_location::current()) noexcept {
__handle_manual_contract_violation(assertion_kind::manual,
    evaluation_semantic::observe, detection_mode::unspecified,
    __comment, __loc, /*__can_throw=*/false);

}

[[noreturn]]  inline void handle_enforced_contract_violation(
    const char* __comment,
    const std::source_location &__loc = std::source_location::current()) {
  __handle_manual_contract_violation(assertion_kind::manual,
                                     evaluation_semantic::enforce, detection_mode::unspecified,
                                     __comment, __loc, /*__can_throw=*/true);
  __libcpp_unreachable();
}


[[noreturn]] inline void handle_enforced_contract_violation(
    std::nothrow_t,
    const char* __comment,
    const std::source_location& __loc = std::source_location::current()
    ) noexcept {
  __handle_manual_contract_violation(assertion_kind::manual,
      evaluation_semantic::enforce, detection_mode::unspecified,
      __comment, __loc, /*__can_throw=*/false);
  __libcpp_unreachable();
}

} // namespace std::contracts

__attribute__((weak)) void handle_contract_violation(const std::contracts::contract_violation&);

#endif // _LIBCPP_CONTRACTS
